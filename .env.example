NODE_ENV="development"
APP_NAME="ARIA Community API"
PORT=3000
API_PREFIX="api/v1"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aria_community?schema=public"
JWT_ACCESS_SECRET="development-access-secret-please-change"
JWT_REFRESH_SECRET="development-refresh-secret-please-change"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
UPLOAD_DIR="uploads"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_SUCCESS_URL="http://localhost:3000/billing/success"
STRIPE_CANCEL_URL="http://localhost:3000/billing/cancel"
STRIPE_BILLING_PORTAL_RETURN_URL="http://localhost:3000/settings/billing"
